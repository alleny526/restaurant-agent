PORT=8787
HOST=0.0.0.0
DATA_FILE=./data/runtime.json
AUTH_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true
ALLOWED_ORIGINS=*
XIAOYI_API_KEY=replace-with-a-random-cloud-plugin-key

# 华为账号登录：在 AppGallery Connect 获取同一 OAuth 2.0 客户端的凭据。
# Client Secret 只能放在 Node 服务端，禁止写入 HarmonyOS 客户端。
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=

# 可选：接入已备案的视觉/OCR 网关。未配置时使用可验证的演示识别器。
VISION_API_URL=
VISION_API_KEY=

# 可选：仅用于润色解释，不允许生成商家事实。
LLM_API_URL=
LLM_API_KEY=
