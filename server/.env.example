PORT=8787
HOST=0.0.0.0
DATA_FILE=./data/restaurant-agent.sqlite
AUTH_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true
ALLOWED_ORIGINS=*
PUBLIC_GATEWAY_PORT=8788
PRIVATE_ORIGIN=http://127.0.0.1:8787
PUBLIC_BASE_URL=

# 高德 Web 服务 API 2.0。Key 只保存在服务端，不得写入 ArkTS 客户端。
AMAP_WEB_KEY=
AMAP_DEFAULT_REGION=南京市
# 可选：经度,纬度。配置后改用周边搜索；为空时按城市关键字搜索。
AMAP_LOCATION=
AMAP_RADIUS_METERS=5000
AMAP_CACHE_TTL_SECONDS=300

# 华为账号登录：在 AppGallery Connect 获取同一 OAuth 2.0 客户端的凭据。
# Client Secret 只能放在 Node 服务端，禁止写入 HarmonyOS 客户端。
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=

# 可选：接入已备案的视觉/OCR 网关。未配置时使用可验证的演示识别器。
VISION_DEMO_MODE=true
VISION_API_URL=
VISION_API_KEY=

# 百度 OCR 兜底：密钥只放服务端，不得写入 ArkTS 客户端或提交 Git。
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# OpenAI-compatible 对话模型。DeepSeek 示例：
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FAST_MODEL=
LLM_TIMEOUT_MS=20000

# Qwen 百炼默认业务空间可改为：
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.8-flash

# 其他 OpenAI-compatible 网关示例：
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=由网关签发的独立项目Key
# LLM_MODEL=gpt-5.6-sol
# LLM_FAST_MODEL=gpt-5.6-luna
